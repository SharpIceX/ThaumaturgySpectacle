{
	// 禁用 VSCode 内置的 LESS 验证功能。
	// 解决和 Stylelint 冲突。
	"less.validate": false,

	// 保存时自动格式化代码
	"editor.formatOnSave": true,

	// 使用 Prettier 作为默认格式化工具
	"editor.defaultFormatter": "esbenp.prettier-vscode",

	// 配置 Unocss 自动补全的匹配类型为模糊匹配模式。
	"unocss.autocomplete.matchType": "fuzzy",

	// 禁用 CMakeLists.txt 文件的缺失警告
	"cmake.ignoreCMakeListsMissing": true,

	// 自定义 CSS 数据文件，用于增强 IntelliSense 支持
	"css.customData": [".vscode/unocss.json"],

	// 配置 ESLint 验证的文件类型
	"eslint.validate": ["astro", "javascript", "typescript"],

	// 配置 UnoCSS 支持的语言类型
	"unocss.languageIds": ["astro", "javascript", "typescript", "less"],

	// 配置 Stylelint 验证的文件类型
	"stylelint.validate": ["astro", "less"],

	// SonarLint 项目信息
	"sonarlint.connectedMode.project": {
		"connectionId": "furryrbl",
		"projectKey": "FurryRbl_ThaumaturgySpectacle"
	}
}
