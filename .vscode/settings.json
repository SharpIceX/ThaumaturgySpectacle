{
	// 保存时自动格式化代码
	"editor.formatOnSave": true,

	// 使用 Prettier 作为默认格式化工具
	"editor.defaultFormatter": "esbenp.prettier-vscode",

	// TypeScript
	"typescript.tsdk": "node_modules/typescript/lib",
	"typescript.enablePromptUseWorkspaceTsdk": true,

	// ESLint 验证的文件类型
	"eslint.validate": ["javascript", "typescript", "vue", "json", "yaml", "github-actions-workflow"],

	"json.schemas": [
		{
			"fileMatch": ["pnpm-workspace.yaml"],
			"url": "https://raw.githubusercontent.com/SchemaStore/schemastore/master/src/schemas/json/pnpm-workspace.json"
		}
	],

	"files.associations": {
		"*.book": "markdown"
	}
}
